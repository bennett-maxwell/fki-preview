#!/bin/bash
# pre-push hook: verify all staged blueprint HTML files return HTTP 200 on GitHub Pages
# build: 2026-05-28

REPO_ROOT="$(git rev-parse --show-toplevel)"
BASE_URL="https://bennett-maxwell.github.io/fki-preview/blueprints"
FAIL=0
WARN=0
CHECKED=0

# Get list of blueprint HTML files being pushed
while IFS= read -r line; do
  sha=$(echo "$line" | awk '{print $2}')
  [[ "$sha" == "0000000000000000000000000000000000000000" ]] && continue
  
  files=$(git diff --name-only "$sha"~1.."$sha" 2>/dev/null | grep '^blueprints/.*\.html$' | grep -v TEMPLATE | grep -v '/chris\.' | grep -v '/melissa-tash\.' | grep -v '/rey\.' || true)
  
  for f in $files; do
    slug=$(basename "$f" .html)

    GK100="$REPO_ROOT/scripts/blueprint_gatekeeper_100.py"
    if [[ -f "$GK100" ]]; then
      mkdir -p /tmp/bp-prepush
      if python3 "$GK100" --html "$REPO_ROOT/$f" --receipt-dir /tmp/bp-prepush --lead "$slug" --mode local --json-output >/tmp/bp-prepush/${slug}-gatekeeper-100.json 2>/tmp/bp-prepush/${slug}-gatekeeper-100.err; then
        echo "  Gatekeeper 100 local PASS  $slug"
      else
        echo "  Gatekeeper 100 local FAIL  $slug"
        ((FAIL++)) || true
      fi
    else
      echo "  Gatekeeper 100 script missing FAIL  $slug"
      ((FAIL++)) || true
    fi

    url="$BASE_URL/$slug.html"
    code=$(curl -s -o /dev/null -w "%{http_code}" --max-time 5 "$url" 2>/dev/null || echo "000")
    if [[ "$code" == "200" ]]; then
      echo "  HTTP 200  $slug"
      ((CHECKED++)) || true
    elif [[ "$code" == "000" ]]; then
      echo "  SKIP (no network or not yet deployed) $slug"
    else
      echo "  HTTP $code POST-PUSH REQUIRED  $slug — $url"
      ((WARN++)) || true
    fi

    # Opt 2 (2026-05-29): verify the podcast MP3 this blueprint references is also live.
    # v2 (2026-05-29): REAL sized GET, not -I HEAD. A HEAD 200 was the exact shallow check
    # behind the false "30/30 verified" claim — it never proved the file was a real MP3.
    # Now require HTTP 200 AND downloaded size >= floor (a 404 stub / empty object fails).
    POD_MIN_BYTES="${POD_MIN_BYTES:-1000000}"
    podpath=$(grep -oE 'podcasts/[A-Za-z0-9_-]+\.mp3' "$REPO_ROOT/$f" 2>/dev/null | head -1)
    if [[ -n "$podpath" ]]; then
      podurl="https://bennett-maxwell.github.io/fki-preview/$podpath"
      read pcode psize < <(curl -sL -o /dev/null -w "%{http_code} %{size_download}" --max-time 120 "$podurl" 2>/dev/null || echo "000 0")
      if [[ "$pcode" == "200" && "${psize:-0}" -ge "$POD_MIN_BYTES" ]]; then
        echo "  HTTP 200 (${psize}b)  podcast: $podpath"
        ((CHECKED++)) || true
      elif [[ "$pcode" == "000" ]]; then
        echo "  SKIP (no network) podcast: $podpath"
      elif [[ "$pcode" == "200" ]]; then
        echo "  HTTP 200 but TOO SMALL (${psize}b < ${POD_MIN_BYTES}) POST-PUSH REQUIRED  podcast: $podpath"
        ((WARN++)) || true
      else
        echo "  HTTP $pcode POST-PUSH REQUIRED  podcast: $podpath — $podurl"
        ((WARN++)) || true
      fi
    fi
  done
done

if [[ $FAIL -gt 0 ]]; then
  echo ""
  echo "Pre-push BLOCKED: $FAIL local Gatekeeper 100 check(s) failed. Fix before push."
  exit 1
fi

[[ $CHECKED -gt 0 ]] && echo "Pre-push: $CHECKED blueprint(s) verified HTTP 200."
if [[ $WARN -gt 0 ]]; then
  echo "Pre-push warning: $WARN public URL check(s) need post-push verification."
  echo "Before any send or ready claim, run: python3 scripts/blueprint_gatekeeper_100.py --mode production --lead <slug> --html blueprints/<slug>.html --receipt-dir <receipts>"
fi
exit 0
