    const sliders = {
      leads: document.getElementById('slider-leads'),
      close: document.getElementById('slider-close'),
      contract: document.getElementById('slider-contract'),
      lift: document.getElementById('slider-lift')
    };
    const vals = {
      leads: document.getElementById('val-leads'),
      close: document.getElementById('val-close'),
      contract: document.getElementById('val-contract'),
      lift: document.getElementById('val-lift')
    };
    const presets = {
      conservative: { leads: 72, close: 0.38, contract: 6800, lift: 0.04 },
      expected:     { leads: 72, close: 0.38, contract: 6800, lift: 0.06 },
      stretch:      { leads: 72, close: 0.38, contract: 6800, lift: 0.09 }
    };
    function setPreset(type) {
      const p = presets[type];
      sliders.leads.value = p.leads;
      sliders.close.value = p.close;
      sliders.contract.value = p.contract;
      sliders.lift.value = p.lift;
      document.querySelectorAll('.preset-btn').forEach(b => b.classList.remove('active'));
      document.querySelector(`.preset-btn[onclick*="${type}"]`).classList.add('active');
      updateCalc();
    }
    function fmt(n) {
      if (n >= 1000000) return '$' + (n/1000000).toFixed(1) + 'M';
      if (n >= 1000) return '$' + Math.round(n/1000) + 'K';
      return '$' + Math.round(n);
    }
    function updateCalc() {
      const leads = parseInt(sliders.leads.value);
      const close = parseFloat(sliders.close.value);
      const contract = parseInt(sliders.contract.value);
      const lift = parseFloat(sliders.lift.value);
      if (sliders.leads.hasAttribute('data-no-default') && !sliders.leads.dataset.touched) {
        vals.leads.textContent = '(enter your number)';
      } else {
        vals.leads.textContent = leads;
      }
      if (sliders.close.hasAttribute('data-no-default') && !sliders.close.dataset.touched) {
        vals.close.textContent = '(enter your number)';
      } else {
        vals.close.textContent = Math.round(close * 100) + '%';
      }
      if (sliders.contract.hasAttribute('data-no-default') && !sliders.contract.dataset.touched) {
        vals.contract.textContent = '(enter your number)';
      } else {
        vals.contract.textContent = fmt(contract);
      }
      vals.lift.textContent = '+' + Math.round(lift * 100) + '%';
      if (!isNaN(leads) && !isNaN(close) && !isNaN(contract) && !isNaN(lift)) {
        const addClose = Math.round(leads * lift);
        const addMonthly = addClose * contract;
        const addAnnual = addMonthly * 12;
        document.getElementById('res-additional-closes').textContent = '+' + addClose;
        document.getElementById('res-monthly-rev').textContent = fmt(addMonthly);
        document.getElementById('res-annual-rev').textContent = fmt(addAnnual);
      }
    }
    // Mark as touched on user interaction
    ['leads','close','contract'].forEach(k => {
      sliders[k].addEventListener('mousedown', () => { sliders[k].dataset.touched = '1'; });
      sliders[k].addEventListener('touchstart', () => { sliders[k].dataset.touched = '1'; });
    });
    // Initialize with expected preset display
    setPreset('expected');
