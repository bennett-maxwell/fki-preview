{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Blueprint AI Lead Profile",
  "description": "Input schema for the Blueprint AI pipeline. All stages read from this file.",
  "type": "object",
  "required": ["lead_name", "business_name", "slug", "accent_color", "industry"],
  "properties": {
    "lead_name": {"type": "string", "description": "Full name of the lead"},
    "lead_first_name": {"type": "string", "description": "First name for email greeting"},
    "business_name": {"type": "string", "description": "Business/company name"},
    "slug": {"type": "string", "description": "URL-safe slug (lowercase, hyphens)", "pattern": "^[a-z0-9-]+$"},
    "url": {"type": "string", "description": "Business website URL"},
    "accent_color": {"type": "string", "description": "Brand accent color hex", "pattern": "^#[0-9a-fA-F]{6}$"},
    "industry": {"type": "string", "description": "Business industry/vertical"},
    "services": {"type": "array", "items": {"type": "string"}, "description": "List of services offered"},
    "tools": {"type": "string", "description": "Current tools/software used"},
    "market": {"type": "string", "description": "Target market description"},
    "service_type": {"type": "string", "description": "Type of services for templates"},
    "speed_to_lead_context": {"type": "string", "description": "Industry-specific speed-to-lead context"},
    "phone": {"type": "string", "description": "Business phone number"},
    "email": {"type": "string", "description": "Business email"},
    "blueprint_url": {"type": "string", "description": "Generated Blueprint HTML URL on GitHub Pages"},
    "website_url": {"type": "string", "description": "Generated demo website URL on GitHub Pages"},
    "podcast_url": {"type": "string", "description": "Generated podcast Drive URL"},
    "apply_subject": {"type": "string", "description": "Email subject for apply CTA"},
    "prompt_1": {"type": "string", "description": "Speed-to-Lead Response Agent prompt"},
    "prompt_2": {"type": "string", "description": "Proposal/Quote Draft Agent prompt"},
    "prompt_3": {"type": "string", "description": "Outreach Agent prompt"}
  }
}
